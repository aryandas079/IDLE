<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="IDLE.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:IDLE"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="IDLE">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootLayout" SizeChanged="OnRootLayoutSizeChanged">
        <SplitView
            x:Name="MenuSplitView"
            DisplayMode="Overlay"
            IsPaneOpen="False"
            OpenPaneLength="250"
            CompactPaneLength="48"
            PaneBackground="{ThemeResource SolidBackgroundFillColorBaseAltBrush}">
            <SplitView.Pane>
                <Grid Padding="16,14,16,16" RowSpacing="12"
                      Background="{ThemeResource SolidBackgroundFillColorBaseAltBrush}"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                      BorderThickness="0,0,1,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Top Header in Pane: Space reserved for the top-left hamburger button -->
                    <Grid Grid.Row="0" Height="40">
                        <TextBlock
                            Margin="52,0,0,0"
                            Text="Categories"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            VerticalAlignment="Center"
                            TextTrimming="CharacterEllipsis" />
                    </Grid>

                    <!-- Main Category Items (Headings only) -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ListView
                            x:Name="CategoriesListView"
                            SelectionMode="Single"
                            SelectedIndex="-1"
                            ItemClick="OnCategoryItemClick"
                            SelectionChanged="OnCategoriesSelectionChanged"
                            IsItemClickEnabled="True">
                            <ListViewItem Tag="Dashboard" CornerRadius="6" Height="40">
                                <StackPanel Orientation="Horizontal" Spacing="14">
                                    <FontIcon Glyph="&#xE80F;" FontSize="16" />
                                    <TextBlock Text="Dashboard" TextTrimming="CharacterEllipsis" FontWeight="Medium" />
                                </StackPanel>
                            </ListViewItem>
                            <ListViewItem Tag="FlashBrightness" CornerRadius="6" Height="40">
                                <StackPanel Orientation="Horizontal" Spacing="14">
                                    <FontIcon Glyph="&#xE706;" FontSize="16" />
                                    <TextBlock Text="Flash &amp; Brightness" TextTrimming="CharacterEllipsis" FontWeight="Medium" />
                                </StackPanel>
                            </ListViewItem>
                            <ListViewItem Tag="MotionVestibular" CornerRadius="6" Height="40">
                                <StackPanel Orientation="Horizontal" Spacing="14">
                                    <FontIcon Glyph="&#xE8B9;" FontSize="16" />
                                    <TextBlock Text="Motion &amp; Vestibular Comfort" TextTrimming="CharacterEllipsis" FontWeight="Medium" />
                                </StackPanel>
                            </ListViewItem>
                            <ListViewItem Tag="DisplayComfort" CornerRadius="6" Height="40">
                                <StackPanel Orientation="Horizontal" Spacing="14">
                                    <FontIcon Glyph="&#xE7F4;" FontSize="16" />
                                    <TextBlock Text="Display &amp; Visual Comfort" TextTrimming="CharacterEllipsis" FontWeight="Medium" />
                                </StackPanel>
                            </ListViewItem>
                            <ListViewItem Tag="SensoryLoad" CornerRadius="6" Height="40">
                                <StackPanel Orientation="Horizontal" Spacing="14">
                                    <FontIcon Glyph="&#xEA8F;" FontSize="16" />
                                    <TextBlock Text="Sensory Load" TextTrimming="CharacterEllipsis" FontWeight="Medium" />
                                </StackPanel>
                            </ListViewItem>
                            <ListViewItem Tag="AdaptiveProfiles" CornerRadius="6" Height="40">
                                <StackPanel Orientation="Horizontal" Spacing="14">
                                    <FontIcon Glyph="&#xE771;" FontSize="16" />
                                    <TextBlock Text="Adaptive Protection &amp; Profiles" TextTrimming="CharacterEllipsis" FontWeight="Medium" />
                                </StackPanel>
                            </ListViewItem>
                            <ListViewItem Tag="ActivityHistory" CornerRadius="6" Height="40">
                                <StackPanel Orientation="Horizontal" Spacing="14">
                                    <FontIcon Glyph="&#xE81C;" FontSize="16" />
                                    <TextBlock Text="Detection &amp; Activity History" TextTrimming="CharacterEllipsis" FontWeight="Medium" />
                                </StackPanel>
                            </ListViewItem>
                            <ListViewItem Tag="PrivacySecurity" CornerRadius="6" Height="40">
                                <StackPanel Orientation="Horizontal" Spacing="14">
                                    <FontIcon Glyph="&#xE72E;" FontSize="16" />
                                    <TextBlock Text="Privacy &amp; Security" TextTrimming="CharacterEllipsis" FontWeight="Medium" />
                                </StackPanel>
                            </ListViewItem>
                        </ListView>
                    </ScrollViewer>

                    <!-- Bottom Pinned Settings & Preferences Item -->
                    <StackPanel Grid.Row="2" Spacing="8">
                        <MenuFlyoutSeparator Margin="4,0,4,4" />
                        <ListView
                            x:Name="SettingsListView"
                            SelectionMode="Single"
                            SelectedIndex="-1"
                            ItemClick="OnCategoryItemClick"
                            SelectionChanged="OnSettingsSelectionChanged"
                            IsItemClickEnabled="True">
                            <ListViewItem Tag="SettingsPreferences" CornerRadius="6" Height="40">
                                <StackPanel Orientation="Horizontal" Spacing="14">
                                    <FontIcon Glyph="&#xE713;" FontSize="16" />
                                    <TextBlock Text="Settings &amp; Preferences" TextTrimming="CharacterEllipsis" FontWeight="Medium" />
                                </StackPanel>
                            </ListViewItem>
                            <ListViewItem Tag="About" CornerRadius="6" Height="40">
                                <StackPanel Orientation="Horizontal" Spacing="14">
                                    <FontIcon Glyph="&#xE946;" FontSize="16" />
                                    <TextBlock Text="About" TextTrimming="CharacterEllipsis" FontWeight="Medium" />
                                </StackPanel>
                            </ListViewItem>
                        </ListView>
                    </StackPanel>
                </Grid>
            </SplitView.Pane>

            <!-- Main Content Area -->
            <Grid Margin="0,56,0,0">
                <Frame x:Name="ContentFrame" />
            </Grid>
        </SplitView>

        <!-- Single Fixed Top-Left Hamburger Button (Above SplitView Overlay) -->
        <Button
            x:Name="OpenNavButton"
            Canvas.ZIndex="100"
            Width="40"
            Height="40"
            Margin="16,14,0,0"
            Padding="0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            ToolTipService.ToolTip="Toggle Navigation"
            Style="{StaticResource SubtleButtonStyle}"
            Click="OnNavToggleClicked">
            <FontIcon Glyph="&#xE700;" FontSize="16" />
        </Button>

        <!-- Top-Right Actions (Theme Switcher + Profile Avatar) -->
        <StackPanel
            Orientation="Horizontal"
            Spacing="8"
            Canvas.ZIndex="100"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="0,14,24,0">

            <!-- Theme Switcher Button -->
            <Button
                x:Name="ThemeToggleButton"
                Width="40"
                Height="40"
                Padding="0"
                ToolTipService.ToolTip="Toggle Theme"
                Style="{StaticResource SubtleButtonStyle}"
                Click="OnThemeToggleClicked">
                <FontIcon x:Name="ThemeIcon" Glyph="&#xE706;" FontSize="17" />
            </Button>

            <!-- Profile Avatar Button -->
            <Button
                x:Name="ProfileButton"
                Width="40"
                Height="40"
                Padding="0"
                ToolTipService.ToolTip="Account &amp; Profile"
                Style="{StaticResource SubtleButtonStyle}">
                <Button.Content>
                    <Grid Width="32" Height="32">
                        <!-- Default 2D Circular Dummy Glyph -->
                        <Border x:Name="UserAvatarDefaultBorder"
                                Width="32" Height="32"
                                CornerRadius="16"
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE77B;" FontSize="15" Foreground="White"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <!-- Circular Photo / Initials (shown when signed in) -->
                        <PersonPicture x:Name="UserAvatarPicture"
                                       Width="32" Height="32"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="Collapsed" />
                    </Grid>
                </Button.Content>

                <!-- Profile Pop-up Flyout -->
                <Button.Flyout>
                    <Flyout x:Name="ProfileFlyout" Placement="BottomEdgeAlignedRight">
                        <Flyout.FlyoutPresenterStyle>
                            <Style TargetType="FlyoutPresenter">
                                <Setter Property="CornerRadius" Value="12" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Width" Value="340" />
                                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                                <Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorBaseAltBrush}" />
                            </Style>
                        </Flyout.FlyoutPresenterStyle>

                        <Grid Padding="20,18" Width="340">
                            <!-- Signed-Out View (Default) -->
                            <StackPanel x:Name="SignedOutPanel" Spacing="18" Visibility="Visible">
                                <!-- Pop-up Header -->
                                <StackPanel Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                        <Border Width="40" Height="40" CornerRadius="20"
                                                Background="{ThemeResource AccentFillColorSecondaryBrush}">
                                            <FontIcon Glyph="&#xE77B;" FontSize="18"
                                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="Welcome to IDLE"
                                                       Style="{StaticResource SubtitleTextBlockStyle}"
                                                       FontSize="16" FontWeight="SemiBold" />
                                            <TextBlock Text="AI &amp; Machine Learning Studio"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Opacity="0.75" />
                                        </StackPanel>
                                    </StackPanel>

                                    <TextBlock Text="Sign in to synchronize workspaces, models, fine-tuning jobs, and custom agents."
                                               Style="{StaticResource BodyTextBlockStyle}"
                                               FontSize="12.5"
                                               Opacity="0.8"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0" />
                                </StackPanel>

                                <MenuFlyoutSeparator Margin="0,2,0,2" />

                                <!-- Microsoft Authentication Option (Centered & Well-Oriented) -->
                                <Button x:Name="MicrosoftSignInButton"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        Height="44"
                                        CornerRadius="8"
                                        Click="OnMicrosoftSignInClicked">
                                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Official Microsoft 4-Square Vector Logo (21x21 viewBox, 10x10 squares, 1px gap, official hex) -->
                                        <Viewbox Grid.Column="0" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <Canvas Width="21" Height="21">
                                                <!-- Top-Left: Red -->
                                                <Rectangle Canvas.Left="0" Canvas.Top="0" Width="10" Height="10" Fill="#F25022" />
                                                <!-- Top-Right: Green -->
                                                <Rectangle Canvas.Left="11" Canvas.Top="0" Width="10" Height="10" Fill="#7FBA00" />
                                                <!-- Bottom-Left: Blue -->
                                                <Rectangle Canvas.Left="0" Canvas.Top="11" Width="10" Height="10" Fill="#00A4EF" />
                                                <!-- Bottom-Right: Yellow -->
                                                <Rectangle Canvas.Left="11" Canvas.Top="11" Width="10" Height="10" Fill="#FFB900" />
                                            </Canvas>
                                        </Viewbox>

                                        <TextBlock Grid.Column="1"
                                                   Text="Continue with Microsoft"
                                                   FontWeight="SemiBold"
                                                   FontSize="13.5"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Button>

                                <!-- Footer note -->
                                <TextBlock Text="By continuing, you agree to IDLE Terms and Privacy Policy."
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           FontSize="11"
                                           Opacity="0.6"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <!-- Signed-In View -->
                            <StackPanel x:Name="SignedInPanel" Spacing="16" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                    <PersonPicture x:Name="FlyoutAvatarPicture"
                                                   Width="44" Height="44"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock x:Name="FlyoutUserNameText"
                                                   Text="Aryan Das"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                                   FontSize="15" />
                                        <TextBlock x:Name="FlyoutUserEmailText"
                                                   Text="aryan@example.com"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Opacity="0.7" />
                                    </StackPanel>
                                </StackPanel>

                                <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="10,6">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE73E;" FontSize="13" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                        <TextBlock x:Name="FlyoutProviderBadgeText"
                                                   Text="Connected via Microsoft Account"
                                                   FontSize="12"
                                                   Opacity="0.85" />
                                    </StackPanel>
                                </Border>

                                <MenuFlyoutSeparator Margin="0,2,0,2" />

                                <Button x:Name="SignOutButton"
                                        HorizontalAlignment="Stretch"
                                        Height="38"
                                        CornerRadius="8"
                                        Click="OnSignOutClicked">
                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xF3B1;" FontSize="15" />
                                        <TextBlock Text="Sign Out" FontWeight="Medium" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </StackPanel>
    </Grid>
</Window>
