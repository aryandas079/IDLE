<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="IDLE.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    SizeChanged="OnPageSizeChanged">

    <Page.Resources>
        <!-- Reference Mockup Color Palette -->
        <Color x:Key="MintAccentColor">#A8F2A6</Color>
        <SolidColorBrush x:Key="MintAccentBrush" Color="{StaticResource MintAccentColor}" />
        <Color x:Key="LavenderAccentColor">#B5A6FF</Color>
        <SolidColorBrush x:Key="LavenderAccentBrush" Color="{StaticResource LavenderAccentColor}" />
        <Color x:Key="CardDarkBgColor">#1D1D20</Color>
        <SolidColorBrush x:Key="CardDarkBgBrush" Color="{StaticResource CardDarkBgColor}" />
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  HorizontalContentAlignment="Stretch">
        <StackPanel Padding="48,28,48,48" Spacing="26" HorizontalAlignment="Stretch">
            <!-- Top Dashboard Header with Responsive Badges -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="System Dashboard" Style="{StaticResource TitleLargeTextBlockStyle}" FontWeight="Bold" FontSize="28" />
                    <TextBlock Text="Local intelligence metrics, signal detection telemetry, and sensory balance overview."
                               Style="{StaticResource SubtitleTextBlockStyle}" Opacity="0.75" FontSize="14" />
                </StackPanel>

                <!-- Top-Right Status Badges -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="20"
                            Padding="14,7">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="#107C41" />
                            <TextBlock x:Name="ActiveProfileHeaderBadge" Text="Standard Profile" FontSize="12.5" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource MintAccentBrush}"
                            CornerRadius="20"
                            Padding="14,7">
                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE73E;" FontSize="13" Foreground="#123B15" />
                            <TextBlock Text="Local Engine Active" FontSize="12.5" FontWeight="SemiBold" Foreground="#123B15" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Responsive Dashboard Grid -->
            <Grid x:Name="DashboardMainGrid" ColumnSpacing="24" RowSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="Col0" Width="1.15*" />
                    <ColumnDefinition x:Name="Col1" Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- CARD 1 (Top-Left): Detection Telemetry with Live Interactive/Responsive Graph -->
                <Border x:Name="Card1" Grid.Row="0" Grid.Column="0"
                        Background="{StaticResource CardDarkBgBrush}"
                        CornerRadius="24"
                        Padding="28"
                        BorderThickness="1"
                        BorderBrush="#2C2C30">
                    <Grid RowSpacing="22">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Card Header -->
                        <Grid Grid.Row="0">
                            <StackPanel Spacing="3">
                                <TextBlock Text="Detection Telemetry" FontSize="20" FontWeight="SemiBold" Foreground="White" />
                                <TextBlock Text="Real-time analyzed continuous frame stream" FontSize="12.5" Foreground="#8E8E93" />
                            </StackPanel>

                            <!-- Interactive Mode Filter Capsule -->
                            <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Background="#2C2C30" CornerRadius="18" Padding="14,6"
                                    Click="OnTelemetryFilterClicked"
                                    Style="{StaticResource SubtleButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock x:Name="TelemetryFilterText" Text="Real-time" FontSize="12" FontWeight="Medium" Foreground="White" />
                                    <FontIcon Glyph="&#xE70D;" FontSize="10" Foreground="#A0A0A5" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Card Content: Metric on Left + Responsive Multi-bar Histogram on Right -->
                        <Grid Grid.Row="1" ColumnSpacing="20" VerticalAlignment="Bottom">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Big Number Metric -->
                            <StackPanel Grid.Column="0" Spacing="6" VerticalAlignment="Bottom">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Text="Frames Analyzed" FontSize="13" Foreground="#9E9EA4" FontWeight="Medium" />
                                    <Border Background="#2E4A32" CornerRadius="10" Padding="5,2">
                                        <FontIcon Glyph="&#xE751;" FontSize="10" Foreground="{StaticResource MintAccentBrush}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock x:Name="FramesAnalyzedCountText" Text="2,480" FontSize="44" FontWeight="Bold" Foreground="White" />
                                <TextBlock Text="+30 FPS live stream" FontSize="12" Foreground="{StaticResource MintAccentBrush}" FontWeight="SemiBold" />
                            </StackPanel>

                            <!-- Responsive Histogram Bars (September / November / Realtime) with Animated Value Height -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="18" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                <!-- Bar 1: Luminance -->
                                <StackPanel Spacing="8" HorizontalAlignment="Center">
                                    <TextBlock Text="Luminance" FontSize="11" Foreground="#9E9EA4" HorizontalAlignment="Center" />
                                    <Grid Width="74" Height="140">
                                        <Border CornerRadius="20" Background="#28282D" />
                                        <Border CornerRadius="20" x:Name="LuminanceBarLavender" Height="100" VerticalAlignment="Bottom" Background="{StaticResource LavenderAccentBrush}">
                                            <Border CornerRadius="20,20,0,0" x:Name="LuminanceBarMint" Height="50" VerticalAlignment="Top" Background="{StaticResource MintAccentBrush}" />
                                        </Border>
                                    </Grid>
                                </StackPanel>

                                <!-- Bar 2: Motion -->
                                <StackPanel Spacing="8" HorizontalAlignment="Center">
                                    <TextBlock Text="Motion" FontSize="11" Foreground="#9E9EA4" HorizontalAlignment="Center" />
                                    <Grid Width="74" Height="160">
                                        <Border CornerRadius="20" Background="#28282D" />
                                        <Border CornerRadius="20" x:Name="MotionBarLavender" Height="140" VerticalAlignment="Bottom" Background="{StaticResource LavenderAccentBrush}">
                                            <Border CornerRadius="20,20,0,0" x:Name="MotionBarMint" Height="95" VerticalAlignment="Top" Background="{StaticResource MintAccentBrush}" />
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- CARD 2 (Top-Right): Recent Detections Activity -->
                <Border x:Name="Card2" Grid.Row="0" Grid.Column="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="24"
                        Padding="26">
                    <Grid RowSpacing="18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Header: Icon, Titles, and Dual Avatar Badges -->
                        <Grid Grid.Row="0">
                            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <Border Width="42" Height="42" CornerRadius="21"
                                        Background="{ThemeResource AccentFillColorSecondaryBrush}">
                                    <FontIcon Glyph="&#xE81C;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Recent Detections" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="Telemetry &amp; local events" FontSize="12.5" Opacity="0.65" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Dual Profile/Detector Avatars -->
                            <StackPanel Orientation="Horizontal" Spacing="-10" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Border Width="34" Height="34" CornerRadius="17" Background="{StaticResource LavenderAccentBrush}"
                                        BorderThickness="2" BorderBrush="{ThemeResource SolidBackgroundFillColorBaseBrush}">
                                    <FontIcon Glyph="&#xE706;" FontSize="14" Foreground="#2A2050" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Border Width="34" Height="34" CornerRadius="17" Background="{StaticResource MintAccentBrush}"
                                        BorderThickness="2" BorderBrush="{ThemeResource SolidBackgroundFillColorBaseBrush}">
                                    <FontIcon Glyph="&#xE8B9;" FontSize="14" Foreground="#123B15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Event pill container -->
                        <Border Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="14" Padding="16,13">
                            <Grid>
                                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE73E;" FontSize="16" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                    <TextBlock x:Name="LatestEventSummaryText" Text="3.4 Hz flash sequence · 94% confidence"
                                               FontSize="13.5" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <FontIcon Glyph="&#xE712;" HorizontalAlignment="Right" FontSize="14" Opacity="0.5" />
                            </Grid>
                        </Border>

                        <!-- Summary and Link -->
                        <Grid Grid.Row="2" VerticalAlignment="Bottom">
                            <StackPanel Spacing="3">
                                <TextBlock Text="Safe State Nominal" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock Text="Zero harsh luminance transitions currently active." FontSize="12" Opacity="0.65" />
                            </StackPanel>
                            <Button Content="View all logs" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    Click="OnViewFullHistoryClicked"
                                    CornerRadius="14" Padding="14,6" FontSize="12" FontWeight="SemiBold" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- CARD 3 (Bottom-Left): Comfort Index with Scalable Gauge -->
                <Border x:Name="Card3" Grid.Row="1" Grid.Column="0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="24"
                        Padding="26">
                    <Grid RowSpacing="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Title and Controls -->
                        <Grid Grid.Row="0">
                            <TextBlock Text="Comfort Index" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                <Button Width="32" Height="32" Padding="0" CornerRadius="16" Style="{StaticResource SubtleButtonStyle}" Click="OnComfortPrevClicked">
                                    <FontIcon Glyph="&#xE76B;" FontSize="12" />
                                </Button>
                                <Button Width="32" Height="32" Padding="0" CornerRadius="16" Style="{StaticResource SubtleButtonStyle}" Click="OnComfortNextClicked">
                                    <FontIcon Glyph="&#xE76C;" FontSize="12" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Mint container -->
                        <Border Grid.Row="1" Background="{StaticResource MintAccentBrush}"
                                CornerRadius="20" Padding="24,20">
                            <Grid ColumnSpacing="20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Left Stats -->
                                <StackPanel VerticalAlignment="Center" Spacing="16">
                                    <Border Width="40" Height="40" CornerRadius="20" Background="White" HorizontalAlignment="Left">
                                        <FontIcon Glyph="&#xE9D9;" FontSize="17" Foreground="#123B15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <TextBlock x:Name="StabilityScoreText" Text="94%" FontSize="22" FontWeight="Bold" Foreground="#123B15" />
                                            <FontIcon Glyph="&#xE751;" FontSize="13" Foreground="#123B15" />
                                        </StackPanel>
                                        <TextBlock Text="Sensory Stability Score" FontSize="12" FontWeight="Medium" Foreground="#255428" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Right: Dynamic Scalable Gauge -->
                                <Viewbox Grid.Column="1" Width="230" Height="130" Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                    <Grid Width="220" Height="130">
                                        <!-- Primary Arch -->
                                        <Path Data="M 20,110 A 80,80 0 0,1 200,110"
                                              Stroke="#18181B"
                                              StrokeThickness="22"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round" />
                                        <!-- Accent Segment -->
                                        <Path Data="M 155,42 A 80,80 0 0,1 200,110"
                                              Stroke="#3E6B41"
                                              StrokeThickness="22"
                                              StrokeDashArray="1,1"
                                              StrokeEndLineCap="Round" />

                                        <!-- Value -->
                                        <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,4">
                                            <Ellipse Width="10" Height="10" Fill="{StaticResource LavenderAccentBrush}"
                                                     HorizontalAlignment="Center" Margin="0,0,0,4" />
                                            <TextBlock x:Name="OptimalComfortText" Text="98.5%" FontSize="24" FontWeight="Bold" Foreground="#123B15" HorizontalAlignment="Center" />
                                            <TextBlock Text="Optimal Comfort" FontSize="11" FontWeight="SemiBold" Foreground="#255428" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                </Viewbox>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- CARD 4 (Bottom-Right): Protection Roadmap & Live Forecast Metrics -->
                <Border x:Name="Card4" Grid.Row="1" Grid.Column="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="24"
                        Padding="26">
                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.1*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Timeline on Left -->
                        <Grid Grid.Column="0">
                            <StackPanel Spacing="16">
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <Border Width="34" Height="34" CornerRadius="17" Background="{StaticResource MintAccentBrush}">
                                        <FontIcon Glyph="&#xE8B9;" FontSize="15" Foreground="#123B15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="Protection Roadmap" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>

                                <Grid Margin="12,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Vertical connecting line -->
                                    <Rectangle Grid.Column="0" Width="2" Fill="{ThemeResource CardStrokeColorDefaultBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Stretch" Margin="0,8,0,8" />

                                    <StackPanel Grid.Column="1" Spacing="16">
                                        <Grid ColumnSpacing="8">
                                            <Ellipse Width="8" Height="8" Fill="{StaticResource MintAccentBrush}" Margin="-24,4,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="Phase 1: Active" FontWeight="Bold" FontSize="12" />
                                                <TextBlock Text="Core visual &amp; motion filters" FontSize="11" Opacity="0.65" />
                                            </StackPanel>
                                        </Grid>

                                        <Grid ColumnSpacing="8">
                                            <Ellipse Width="8" Height="8" Fill="{StaticResource LavenderAccentBrush}" Margin="-24,4,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="Phase 2: Ready" FontWeight="Bold" FontSize="12" />
                                                <TextBlock Text="Custom profiles &amp; sensory load" FontSize="11" Opacity="0.65" />
                                            </StackPanel>
                                        </Grid>

                                        <Grid ColumnSpacing="8">
                                            <Ellipse Width="8" Height="8" Fill="#1E1E22" Margin="-24,4,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="Phase 3: Browser" FontWeight="Bold" FontSize="12" />
                                                <TextBlock Text="Per-site script damping" FontSize="11" Opacity="0.65" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <!-- Right Column: Stacked Mint & Lavender Metric Cards with Dynamic Sliders -->
                        <Grid Grid.Column="1" RowSpacing="14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Mint Card -->
                            <Border Grid.Row="0" Background="{StaticResource MintAccentBrush}"
                                    CornerRadius="18" Padding="14,12">
                                <Grid>
                                    <FontIcon Glyph="&#xE751;" FontSize="13" Foreground="#123B15" HorizontalAlignment="Right" VerticalAlignment="Top" />
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Signal Sensitivity" FontSize="11" FontWeight="Medium" Foreground="#255428" />
                                        <TextBlock x:Name="SignalSensitivityText" Text="3.0 Hz" FontSize="20" FontWeight="Bold" Foreground="#123B15" />

                                        <Grid Margin="0,6,0,0" Height="14">
                                            <Border CornerRadius="7" Background="#8EEB8C" Height="10" VerticalAlignment="Center" />
                                            <Border CornerRadius="7" Width="48" Height="10" Background="#3E6B41"
                                                    HorizontalAlignment="Left" VerticalAlignment="Center" />
                                            <Ellipse Width="12" Height="12" Fill="{StaticResource LavenderAccentBrush}"
                                                     HorizontalAlignment="Left" Margin="42,0,0,0" />
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Lavender Card -->
                            <Border Grid.Row="1" Background="{StaticResource LavenderAccentBrush}"
                                    CornerRadius="18" Padding="14,12">
                                <Grid>
                                    <FontIcon Glyph="&#xE751;" FontSize="13" Foreground="#2A2050" HorizontalAlignment="Right" VerticalAlignment="Top" />
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Active Detectors" FontSize="11" FontWeight="Medium" Foreground="#4A3F7A" />
                                        <TextBlock Text="8 Active" FontSize="20" FontWeight="Bold" Foreground="#2A2050" />

                                        <Grid Height="20" Margin="0,4,0,0">
                                            <Path Data="M 0,16 Q 30,12 60,8 T 120,4"
                                                  Stroke="#2A2050" StrokeThickness="2" VerticalAlignment="Center" />
                                            <Ellipse Width="8" Height="8" Fill="{StaticResource MintAccentBrush}"
                                                     HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,4,0" />
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
