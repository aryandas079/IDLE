<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="IDLE.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    SizeChanged="OnPageSizeChanged">

    <Page.Resources>
        <!-- Reference Mockup Color Palette -->
        <Color x:Key="MintAccentColor">#A8F2A6</Color>
        <SolidColorBrush x:Key="MintAccentBrush" Color="{StaticResource MintAccentColor}" />
        <Color x:Key="LavenderAccentColor">#B5A6FF</Color>
        <SolidColorBrush x:Key="LavenderAccentBrush" Color="{StaticResource LavenderAccentColor}" />
        <Color x:Key="CardDarkBgColor">#1D1D20</Color>
        <SolidColorBrush x:Key="CardDarkBgBrush" Color="{StaticResource CardDarkBgColor}" />
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  HorizontalContentAlignment="Stretch">
        <StackPanel Padding="48,28,48,48" Spacing="26" HorizontalAlignment="Stretch">
            <!-- Top Dashboard Header with Responsive Badges -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="System Dashboard" Style="{StaticResource TitleLargeTextBlockStyle}" FontWeight="Bold" FontSize="28" />
                    <TextBlock Text="Local intelligence metrics, signal detection telemetry, and sensory balance overview."
                               Style="{StaticResource SubtitleTextBlockStyle}" Opacity="0.75" FontSize="14" />
                </StackPanel>

                <!-- Top-Right Status Badges -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="20"
                            Padding="14,7">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="#107C41" />
                            <TextBlock x:Name="ActiveProfileHeaderBadge" Text="Standard Profile" FontSize="12.5" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource MintAccentBrush}"
                            CornerRadius="20"
                            Padding="14,7">
                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE73E;" FontSize="13" Foreground="#123B15" />
                            <TextBlock Text="Local Engine Active" FontSize="12.5" FontWeight="SemiBold" Foreground="#123B15" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Responsive Dashboard Grid -->
            <Grid x:Name="DashboardMainGrid" ColumnSpacing="24" RowSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="Col0" Width="1.15*" />
                    <ColumnDefinition x:Name="Col1" Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- CARD 1 (Top-Left): Detection Telemetry with Live Interactive/Responsive Graph -->
                <Border x:Name="Card1" Grid.Row="0" Grid.Column="0"
                        Background="{StaticResource CardDarkBgBrush}"
                        CornerRadius="24"
                        Padding="28"
                        BorderThickness="1"
                        BorderBrush="#2C2C30">
                    <Grid RowSpacing="22">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Card Header -->
                        <Grid Grid.Row="0">
                            <StackPanel Spacing="3">
                                <TextBlock Text="Detection Telemetry" FontSize="20" FontWeight="SemiBold" Foreground="White" />
                                <TextBlock Text="Real-time analyzed continuous frame stream" FontSize="12.5" Foreground="#8E8E93" />
                            </StackPanel>

                            <!-- Interactive Mode Filter Capsule -->
                            <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Background="#2C2C30" CornerRadius="18" Padding="14,6"
                                    Click="OnTelemetryFilterClicked"
                                    Style="{StaticResource SubtleButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock x:Name="TelemetryFilterText" Text="Real-time" FontSize="12" FontWeight="Medium" Foreground="White" />
                                    <FontIcon Glyph="&#xE70D;" FontSize="10" Foreground="#A0A0A5" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Card Content: Metric on Left + Responsive Multi-bar Histogram on Right -->
                        <Grid Grid.Row="1" ColumnSpacing="20" VerticalAlignment="Bottom">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Big Number Metric -->
                            <StackPanel Grid.Column="0" Spacing="6" VerticalAlignment="Bottom">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Text="Frames Analyzed" FontSize="13" Foreground="#9E9EA4" FontWeight="Medium" />
                                    <Border Background="#2E4A32" CornerRadius="10" Padding="5,2">
                                        <FontIcon Glyph="&#xE751;" FontSize="10" Foreground="{StaticResource MintAccentBrush}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock x:Name="FramesAnalyzedCountText" Text="2,480" FontSize="44" FontWeight="Bold" Foreground="White" />
                                <TextBlock Text="+30 FPS live stream" FontSize="12" Foreground="{StaticResource MintAccentBrush}" FontWeight="SemiBold" />
                            </StackPanel>

                            <!-- Responsive Histogram Bars Matching Original Concept (Hatched Top Track + Bi-color Bottom Fill) -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="20" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                <!-- Bar 1: September / Luminance -->
                                <StackPanel Spacing="8" HorizontalAlignment="Center">
                                    <TextBlock x:Name="LuminanceBarLabel" Text="September" FontSize="11" Foreground="#9E9EA4" HorizontalAlignment="Center" />
                                    <!-- Outer bar capsule -->
                                    <Border Width="76" Height="140" CornerRadius="22" Background="#28282D"
                                            BorderBrush="#38383D" BorderThickness="1">
                                        <!-- Inside Bar -->
                                        <Grid VerticalAlignment="Stretch">
                                            <!-- Top Hatched / Pattern Area (representing headroom / unreached threshold) -->
                                            <Path Data="M 10,12 L 66,68 M 25,12 L 66,53 M 40,12 L 66,38 M 10,27 L 66,83 M 10,42 L 54,86"
                                                  Stroke="#3A3A40" StrokeThickness="1.5" Opacity="0.6" VerticalAlignment="Top" />

                                            <!-- Bottom Dual-Color Fill: Mint top rounded pill over Lavender bottom rounded base -->
                                            <Border CornerRadius="18" x:Name="LuminanceBarLavender" Height="85" VerticalAlignment="Bottom"
                                                    Background="{StaticResource LavenderAccentBrush}">
                                                <!-- Top portion: Mint -->
                                                <Border CornerRadius="18,18,0,0" x:Name="LuminanceBarMint" Height="42" VerticalAlignment="Top"
                                                        Background="{StaticResource MintAccentBrush}" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <!-- Bar 2: November / Motion -->
                                <StackPanel Spacing="8" HorizontalAlignment="Center">
                                    <TextBlock x:Name="MotionBarLabel" Text="November" FontSize="11" Foreground="#9E9EA4" HorizontalAlignment="Center" />
                                    <Border Width="76" Height="165" CornerRadius="22" Background="#28282D"
                                            BorderBrush="#38383D" BorderThickness="1">
                                        <Grid VerticalAlignment="Stretch">
                                            <!-- Top Hatched / Pattern Area -->
                                            <Path Data="M 10,12 L 66,68 M 25,12 L 66,53 M 40,12 L 66,38 M 10,27 L 66,83 M 10,42 L 66,98"
                                                  Stroke="#3A3A40" StrokeThickness="1.5" Opacity="0.6" VerticalAlignment="Top" />

                                            <!-- Bottom Dual-Color Fill -->
                                            <Border CornerRadius="18" x:Name="MotionBarLavender" Height="125" VerticalAlignment="Bottom"
                                                    Background="{StaticResource LavenderAccentBrush}">
                                                <Border CornerRadius="18,18,0,0" x:Name="MotionBarMint" Height="82" VerticalAlignment="Top"
                                                        Background="{StaticResource MintAccentBrush}" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- CARD 2 (Top-Right): Recent Detections Activity -->
                <Border x:Name="Card2" Grid.Row="0" Grid.Column="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="24"
                        Padding="26">
                    <Grid RowSpacing="18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Header: Icon, Titles, and Dual Avatar Badges -->
                        <Grid Grid.Row="0">
                            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <Border Width="42" Height="42" CornerRadius="21"
                                        Background="{ThemeResource AccentFillColorSecondaryBrush}">
                                    <FontIcon Glyph="&#xE81C;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Recent Detections" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="Telemetry &amp; local events" FontSize="12.5" Opacity="0.65" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Dual Profile/Detector Avatars -->
                            <StackPanel Orientation="Horizontal" Spacing="-10" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Border Width="34" Height="34" CornerRadius="17" Background="{StaticResource LavenderAccentBrush}"
                                        BorderThickness="2" BorderBrush="{ThemeResource SolidBackgroundFillColorBaseBrush}">
                                    <FontIcon Glyph="&#xE706;" FontSize="14" Foreground="#2A2050" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Border Width="34" Height="34" CornerRadius="17" Background="{StaticResource MintAccentBrush}"
                                        BorderThickness="2" BorderBrush="{ThemeResource SolidBackgroundFillColorBaseBrush}">
                                    <FontIcon Glyph="&#xE8B9;" FontSize="14" Foreground="#123B15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Event pill container -->
                        <Border Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="14" Padding="16,13">
                            <Grid>
                                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE73E;" FontSize="16" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                    <TextBlock x:Name="LatestEventSummaryText" Text="3.4 Hz flash sequence · 94% confidence"
                                               FontSize="13.5" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <FontIcon Glyph="&#xE712;" HorizontalAlignment="Right" FontSize="14" Opacity="0.5" />
                            </Grid>
                        </Border>

                        <!-- Summary and Link -->
                        <Grid Grid.Row="2" VerticalAlignment="Bottom">
                            <StackPanel Spacing="3">
                                <TextBlock Text="Safe State Nominal" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock Text="Zero harsh luminance transitions currently active." FontSize="12" Opacity="0.65" />
                            </StackPanel>
                            <Button Content="View all logs" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    Click="OnViewFullHistoryClicked"
                                    CornerRadius="14" Padding="14,6" FontSize="12" FontWeight="SemiBold" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- CARD 3 (Bottom-Left): Comfort Index with Exact Authentic Hatched Arch Gauge -->
                <Border x:Name="Card3" Grid.Row="1" Grid.Column="0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="24"
                        Padding="26">
                    <Grid RowSpacing="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Title and Controls -->
                        <Grid Grid.Row="0">
                            <TextBlock Text="Comfort Index" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                <Button Width="32" Height="32" Padding="0" CornerRadius="16" Style="{StaticResource SubtleButtonStyle}" Click="OnComfortPrevClicked">
                                    <FontIcon Glyph="&#xE76B;" FontSize="12" />
                                </Button>
                                <Button Width="32" Height="32" Padding="0" CornerRadius="16" Style="{StaticResource SubtleButtonStyle}" Click="OnComfortNextClicked">
                                    <FontIcon Glyph="&#xE76C;" FontSize="12" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Mint container -->
                        <Border Grid.Row="1" Background="{StaticResource MintAccentBrush}"
                                CornerRadius="20" Padding="24,20">
                            <Grid ColumnSpacing="20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Left Stats -->
                                <StackPanel VerticalAlignment="Center" Spacing="16">
                                    <Border Width="40" Height="40" CornerRadius="20" Background="White" HorizontalAlignment="Left">
                                        <FontIcon Glyph="&#xE9D9;" FontSize="17" Foreground="#123B15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <TextBlock x:Name="StabilityScoreText" Text="94%" FontSize="22" FontWeight="Bold" Foreground="#123B15" />
                                            <FontIcon Glyph="&#xE751;" FontSize="13" Foreground="#123B15" />
                                        </StackPanel>
                                        <TextBlock Text="Sensory Stability Score" FontSize="12" FontWeight="Medium" Foreground="#255428" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Right: Authentic Stylized Arc Gauge Matching Mockup Exactly -->
                                <Viewbox Grid.Column="1" Width="280" Height="150" Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                    <Grid Width="280" Height="150">
                                        <!-- Pivot / Needle in center (Center of arc is at X=140, Y=125, Radius=90) -->
                                        <!-- Arc spans from Left (140 - 90 = 50, 125) up to peak (140, 35) to ~42° (207, 65) -->
                                        <!-- Solid Charcoal Arc -->
                                        <Path Data="M 50,125 A 90,90 0 0,1 207,65"
                                              Stroke="#1D1D20"
                                              StrokeThickness="26"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Flat" />

                                        <!-- Outer & Inner Rail Borders for the Ladder Segment -->
                                        <!-- Outer Rail: R = 103 (from 216, 56 to 230, 125) -->
                                        <!-- Inner Rail: R = 77  (from 197, 74 to 217, 125) -->
                                        <Path Data="M 216,56 A 103,103 0 0,1 243,125"
                                              Stroke="#1D1D20"
                                              StrokeThickness="2" />
                                        <Path Data="M 197,74 A 77,77 0 0,1 217,125"
                                              Stroke="#1D1D20"
                                              StrokeThickness="2" />

                                        <!-- Transverse Rung Lines -->
                                        <Line X1="197" Y1="74" X2="216" Y2="56" Stroke="#1D1D20" StrokeThickness="2.2" />
                                        <Line X1="203" Y1="84" X2="224" Y2="70" Stroke="#1D1D20" StrokeThickness="2.2" />
                                        <Line X1="209" Y1="95" X2="231" Y2="84" Stroke="#1D1D20" StrokeThickness="2.2" />
                                        <Line X1="213" Y1="107" X2="237" Y2="99" Stroke="#1D1D20" StrokeThickness="2.2" />
                                        <Line X1="216" Y1="117" X2="241" Y2="112" Stroke="#1D1D20" StrokeThickness="2.2" />
                                        <Line X1="217" Y1="125" X2="243" Y2="125" Stroke="#1D1D20" StrokeThickness="2.2" />

                                        <!-- Dark Green Rounded Terminal Bulb at bottom right -->
                                        <Path Data="M 217,125 A 13,13 0 0,0 243,125 Z"
                                              Fill="#264A2A"
                                              Stroke="#1D1D20"
                                              StrokeThickness="1.5" />

                                        <!-- Central Pivot with Lavender Circle and Slender Dark Needle -->
                                        <Grid Width="36" Height="36" Margin="122,58,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
                                            <Ellipse Width="16" Height="16" Fill="{StaticResource LavenderAccentBrush}"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <!-- Crisp slender needle pointing at 45 degrees toward transition point -->
                                            <Line X1="18" Y1="18" X2="28" Y2="8"
                                                  Stroke="#1D1D20" StrokeThickness="2.5"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                        </Grid>

                                        <!-- Metric in the Lower Center -->
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8">
                                            <TextBlock x:Name="OptimalComfortText" Text="98.2%" FontSize="28" FontWeight="Bold" Foreground="#123B15" HorizontalAlignment="Center" />
                                            <TextBlock Text="Optimal Comfort" FontSize="11.5" FontWeight="SemiBold" Foreground="#255428" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Viewbox>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- CARD 4 (Bottom-Right): Protection Roadmap & Live Forecast Metrics -->
                <Border x:Name="Card4" Grid.Row="1" Grid.Column="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="24"
                        Padding="26">
                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.1*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Timeline on Left -->
                        <Grid Grid.Column="0">
                            <StackPanel Spacing="16">
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <Border Width="34" Height="34" CornerRadius="17" Background="{StaticResource MintAccentBrush}">
                                        <FontIcon Glyph="&#xE8B9;" FontSize="15" Foreground="#123B15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="Protection Roadmap" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>

                                <Grid Margin="12,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Vertical connecting line -->
                                    <Rectangle Grid.Column="0" Width="2" Fill="{ThemeResource CardStrokeColorDefaultBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Stretch" Margin="0,8,0,8" />

                                    <StackPanel Grid.Column="1" Spacing="16">
                                        <Grid ColumnSpacing="8">
                                            <Ellipse Width="8" Height="8" Fill="{StaticResource MintAccentBrush}" Margin="-24,4,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="Phase 1: Active" FontWeight="Bold" FontSize="12" />
                                                <TextBlock Text="Core visual &amp; motion filters" FontSize="11" Opacity="0.65" />
                                            </StackPanel>
                                        </Grid>

                                        <Grid ColumnSpacing="8">
                                            <Ellipse Width="8" Height="8" Fill="{StaticResource LavenderAccentBrush}" Margin="-24,4,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="Phase 2: Ready" FontWeight="Bold" FontSize="12" />
                                                <TextBlock Text="Custom profiles &amp; sensory load" FontSize="11" Opacity="0.65" />
                                            </StackPanel>
                                        </Grid>

                                        <Grid ColumnSpacing="8">
                                            <Ellipse Width="8" Height="8" Fill="#1E1E22" Margin="-24,4,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="Phase 3: Browser" FontWeight="Bold" FontSize="12" />
                                                <TextBlock Text="Per-site script damping" FontSize="11" Opacity="0.65" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <!-- Right Column: Stacked Mint & Lavender Metric Cards with Dynamic Sliders -->
                        <Grid Grid.Column="1" RowSpacing="14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Mint Card with Hatched Slider Track matching Mockup -->
                            <Border Grid.Row="0" Background="{StaticResource MintAccentBrush}"
                                    CornerRadius="18" Padding="14,12">
                                <Grid>
                                    <FontIcon Glyph="&#xE751;" FontSize="13" Foreground="#123B15" HorizontalAlignment="Right" VerticalAlignment="Top" />
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Signal Sensitivity" FontSize="11" FontWeight="Medium" Foreground="#255428" />
                                        <TextBlock x:Name="SignalSensitivityText" Text="3.0 Hz" FontSize="20" FontWeight="Bold" Foreground="#123B15" />

                                        <!-- Progress bar with striped hatch and lavender needle matching reference -->
                                        <Grid Margin="0,6,0,0" Height="16">
                                            <Border CornerRadius="8" Background="#8EEB8C" Height="12" VerticalAlignment="Center"
                                                    BorderBrush="#255428" BorderThickness="1" />
                                            <!-- Hatched filled segment -->
                                            <Border CornerRadius="7,0,0,7" Width="65" Height="10"
                                                    HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <Rectangle Fill="#326336" Opacity="0.85" />
                                            </Border>
                                            <Rectangle Width="65" Height="10" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <Rectangle.Fill>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#255428" Offset="0.0" />
                                                        <GradientStop Color="Transparent" Offset="0.5" />
                                                    </LinearGradientBrush>
                                                </Rectangle.Fill>
                                            </Rectangle>
                                            <!-- Vertical Divider / Lavender Needle indicator -->
                                            <Ellipse Width="12" Height="12" Fill="{StaticResource LavenderAccentBrush}"
                                                     Stroke="#123B15" StrokeThickness="1.5"
                                                     HorizontalAlignment="Left" Margin="59,0,0,0" />
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Lavender Card with Sparkline & Highlight Point -->
                            <Border Grid.Row="1" Background="{StaticResource LavenderAccentBrush}"
                                    CornerRadius="18" Padding="14,12">
                                <Grid>
                                    <FontIcon Glyph="&#xE751;" FontSize="13" Foreground="#2A2050" HorizontalAlignment="Right" VerticalAlignment="Top" />
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Active Detectors" FontSize="11" FontWeight="Medium" Foreground="#4A3F7A" />
                                        <TextBlock Text="8 Active" FontSize="20" FontWeight="Bold" Foreground="#2A2050" />

                                        <Grid Height="24" Margin="0,2,0,0">
                                            <!-- Smooth upward curve matching mockup -->
                                            <Path Data="M 0,20 C 35,20 50,6 80,6 C 100,6 115,16 135,10"
                                                  Stroke="#2A2050" StrokeThickness="2" VerticalAlignment="Center" />
                                            <Ellipse Width="8" Height="8" Fill="{StaticResource MintAccentBrush}"
                                                     Stroke="#2A2050" StrokeThickness="1.5"
                                                     HorizontalAlignment="Left" Margin="76,1,0,0" />
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
