<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="IDLE.Views.FlashBrightnessPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="36,24,36,40" Spacing="24" MaxWidth="1100" HorizontalAlignment="Stretch">
            <!-- Header -->
            <StackPanel Spacing="6">
                <TextBlock Text="Flash &amp; Brightness" Style="{StaticResource TitleLargeTextBlockStyle}" FontWeight="SemiBold" />
                <TextBlock Text="Engineering parameters for luminance transitions, repeated flash analysis, contrast patterns, and display response."
                           Style="{StaticResource SubtitleTextBlockStyle}" Opacity="0.75" TextWrapping="Wrap" />
            </StackPanel>

            <!-- Important Engineering Notice Banner -->
            <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,14">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE783;" FontSize="18" Foreground="{ThemeResource SystemFillColorCautionBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="Engineering Detection Disclaimer" FontWeight="SemiBold" FontSize="13" />
                        <TextBlock Text="These thresholds are engineering detection parameters, not medically validated safety limits. A frequency threshold alone cannot establish whether content is safe for every user."
                                   Opacity="0.78" FontSize="12.5" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Section 2.1 & 2.2: Flash & Transition Detection -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock Text="2.1 &amp; 2.2 Flash &amp; Luminance Transition Detection" Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="SemiBold" />
                    
                    <ToggleSwitch x:Name="FlashDetectionToggle" Header="Continuous Flash Analysis"
                                  OffContent="Disabled" OnContent="Active screen analysis"
                                  Toggled="OnSettingChanged" />

                    <Grid ColumnSpacing="16" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <CheckBox Grid.Row="0" Grid.Column="0" x:Name="BrightToDarkCheck" Content="Bright-to-dark transition detection (abrupt decrease)" Click="OnSettingChanged" />
                        <CheckBox Grid.Row="0" Grid.Column="1" x:Name="DarkToBrightCheck" Content="Dark-to-bright transition detection (abrupt increase)" Click="OnSettingChanged" />
                        <CheckBox Grid.Row="1" Grid.Column="0" x:Name="RepeatedFlashCheck" Content="Repeated flash detection (oscillating sequence)" Click="OnSettingChanged" />
                        <CheckBox Grid.Row="1" Grid.Column="1" x:Name="AlternatingPatternCheck" Content="Alternating pattern &amp; color-transition analysis" Click="OnSettingChanged" />
                        <CheckBox Grid.Row="2" Grid.Column="0" x:Name="LocalizedFlashCheck" Content="Localized quadrant analysis (sub-frame regions)" Click="OnSettingChanged" />
                        <CheckBox Grid.Row="2" Grid.Column="1" x:Name="FullScreenFlashCheck" Content="Full-screen flash detection (broad frame changes)" Click="OnSettingChanged" />
                    </Grid>

                    <MenuFlyoutSeparator Margin="0,4,0,4" />

                    <!-- Sliders for Thresholds -->
                    <Grid ColumnSpacing="24" RowSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                            <TextBlock Text="Flash frequency threshold (Hz)" FontWeight="Medium" />
                            <Slider x:Name="FrequencySlider" Minimum="1" Maximum="30" StepFrequency="0.5" ValueChanged="OnSettingChanged" />
                            <TextBlock x:Name="FrequencyLabel" Text="3.0 Hz" FontSize="12" Opacity="0.7" />
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
                            <TextBlock Text="Flash intensity magnitude threshold (%)" FontWeight="Medium" />
                            <Slider x:Name="IntensitySlider" Minimum="10" Maximum="90" StepFrequency="5" ValueChanged="OnSettingChanged" />
                            <TextBlock x:Name="IntensityLabel" Text="35%" FontSize="12" Opacity="0.7" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Spacing="4">
                            <TextBlock Text="Minimum event duration filter (ms)" FontWeight="Medium" />
                            <Slider x:Name="DurationSlider" Minimum="50" Maximum="500" StepFrequency="25" ValueChanged="OnSettingChanged" />
                            <TextBlock x:Name="DurationLabel" Text="150 ms" FontSize="12" Opacity="0.7" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                            <TextBlock Text="Detection cooldown window (seconds)" FontWeight="Medium" />
                            <Slider x:Name="CooldownSlider" Minimum="1" Maximum="30" StepFrequency="1" ValueChanged="OnSettingChanged" />
                            <TextBlock x:Name="CooldownLabel" Text="5 s" FontSize="12" Opacity="0.7" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Section 2.3 & 2.4: Brightness Adjustment & Glare -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock Text="2.3 &amp; 2.4 Brightness Adjustments &amp; Glare Reduction" Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="SemiBold" />
                    
                    <StackPanel Spacing="6">
                        <TextBlock Text="Preferred display brightness level (%)" FontWeight="Medium" />
                        <Slider x:Name="BrightnessSlider" Minimum="10" Maximum="100" StepFrequency="5" ValueChanged="OnSettingChanged" />
                        <TextBlock x:Name="BrightnessLabel" Text="70%" FontSize="12" Opacity="0.7" />
                    </StackPanel>

                    <CheckBox x:Name="GradualBrightnessCheck" Content="Enable gradual brightness transitions (smoothen rapid adjustments)" Click="OnSettingChanged" />
                    <CheckBox x:Name="RestoreBrightnessCheck" Content="Restore previous brightness after event resolution" Click="OnSettingChanged" />
                    <CheckBox x:Name="PauseGamingCheck" Content="Disable automatic adjustments while gaming or presenting (full-screen focus)" Click="OnSettingChanged" />

                    <MenuFlyoutSeparator Margin="0,4,0,4" />

                    <ToggleSwitch x:Name="DimmingOverlayToggle" Header="Optional Software Dimming Overlay"
                                  OffContent="Disabled" OnContent="Active software comfort scrim"
                                  Toggled="OnSettingChanged" />
                    <TextBlock Text="Note: A software dimming overlay makes content visually darker, but is not equivalent to physically reducing hardware backlight."
                               FontSize="12" Opacity="0.65" TextWrapping="Wrap" />

                    <StackPanel Spacing="4" Margin="0,4,0,0">
                        <TextBlock Text="Dimming overlay opacity" FontWeight="Medium" />
                        <Slider x:Name="OverlayOpacitySlider" Minimum="5" Maximum="80" StepFrequency="5" ValueChanged="OnSettingChanged" />
                        <TextBlock x:Name="OverlayOpacityLabel" Text="25%" FontSize="12" Opacity="0.7" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Section 2.5 & 2.6: Contrast Patterns & Response Settings -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock Text="2.5 &amp; 2.6 High-Contrast Patterns &amp; Response Policies" Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="SemiBold" />

                    <CheckBox x:Name="HighContrastPatternCheck" Content="Detect repeated high-contrast stripes or repetitive geometric patterns" Click="OnSettingChanged" />

                    <StackPanel Spacing="8">
                        <TextBlock Text="Intervention Style after Detection:" FontWeight="Medium" />
                        <ComboBox x:Name="ResponseModeCombo" Width="380" SelectionChanged="OnResponseModeChanged">
                            <ComboBoxItem Content="Detect &amp; Explain (Ask Before Changing) - Recommended" />
                            <ComboBoxItem Content="Unobtrusive Notification Only" />
                            <ComboBoxItem Content="Automatically Apply Reversible Damping" />
                            <ComboBoxItem Content="Log to History Only" />
                        </ComboBox>
                        <TextBlock Text="Recommended default: detect and explain first, then ask before modifying the user's environment."
                                   FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
                        <Button Content="Simulate Sample Flash Event" Click="OnSimulateFlashClicked" />
                        <Button Content="Reset Section to Engineering Defaults" Click="OnResetDefaultsClicked" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
