<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="IDLE.Views.SettingsPreferencesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="36,24,36,40" Spacing="24" MaxWidth="1100" HorizontalAlignment="Stretch">
            <!-- Header -->
            <StackPanel Spacing="6">
                <TextBlock Text="Settings &amp; Preferences" Style="{StaticResource TitleLargeTextBlockStyle}" FontWeight="SemiBold" />
                <TextBlock Text="Core interface customization, interaction behaviors, and detector engine sampling parameters."
                           Style="{StaticResource SubtitleTextBlockStyle}" Opacity="0.75" TextWrapping="Wrap" />
            </StackPanel>

            <!-- 8. Accessibility & Interaction Settings -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock Text="8. Accessibility &amp; Interaction Preferences" Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="SemiBold" />

                    <CheckBox x:Name="ReducedAnimationsCheck" Content="Reduce animations and layout transitions within IDLE itself" Click="OnSettingChanged" />
                    <CheckBox x:Name="ConfirmChangesCheck" Content="Ask for confirmation before applying significant visual adjustments" Click="OnSettingChanged" />
                    <CheckBox x:Name="DismissibleAlertsCheck" Content="Ensure all alert notifications remain dismissible without modal lockups" Click="OnSettingChanged" />
                    <CheckBox Content="Support screen-reader labels and Windows high-contrast themes" IsChecked="True" />
                </StackPanel>
            </Border>

            <!-- 9.3 Advanced Engine Tuning -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock Text="9.3 Signal Processing Engine &amp; Sampling" Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="SemiBold" />

                    <StackPanel Spacing="4">
                        <TextBlock Text="Engine analysis sampling rate (FPS)" FontWeight="Medium" />
                        <Slider x:Name="FpsSlider" Minimum="10" Maximum="60" StepFrequency="5" ValueChanged="OnSettingChanged" />
                        <TextBlock x:Name="FpsLabel" Text="30 FPS" FontSize="12" Opacity="0.7" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Local activity history retention period (days)" FontWeight="Medium" />
                        <Slider x:Name="RetentionSlider" Minimum="7" Maximum="90" StepFrequency="7" ValueChanged="OnSettingChanged" />
                        <TextBlock x:Name="RetentionLabel" Text="30 days" FontSize="12" Opacity="0.7" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
