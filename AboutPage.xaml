<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="IDLE.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:IDLE"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="36,12,36,36">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="380" />
        </Grid.ColumnDefinitions>

        <!-- Left Column: Project Overview, Summary, and Documentation Expanders -->
        <ScrollViewer Grid.Column="0" Margin="0,0,32,0" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="24" MaxWidth="800" HorizontalAlignment="Left">

                <!-- Header / App Title -->
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                        <Border Width="48" Height="48" CornerRadius="10" Background="#2C2D30">
                            <Image Source="Assets/Square44x44Logo.scale-200.png" Width="40" Height="40" Stretch="Uniform" />
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="IDLE" Style="{StaticResource TitleLargeTextBlockStyle}" FontWeight="Bold" />
                            <TextBlock Text="Intelligent Detection Layer for Experience" Style="{StaticResource SubtitleTextBlockStyle}" Opacity="0.8" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="Detect. Assess. Adapt. Keep the user in control." FontStyle="Italic" Opacity="0.75" Margin="0,6,0,0" />
                </StackPanel>

                <!-- Summary Paragraph Card -->
                <Border Padding="20" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="What We Are Building" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock TextWrapping="Wrap" LineHeight="22" Opacity="0.9"
                                   Text="IDLE is an experimental, privacy-first sensory protection layer designed to detect potentially overwhelming digital stimuli—such as rapid animations, flashing imagery, sudden luminance transitions, and intense visual motion—in supported environments and apply proportionate, user-controlled protective adjustments." />
                        <TextBlock TextWrapping="Wrap" LineHeight="22" Opacity="0.8"
                                   Text="Built with local ephemeral frame processing at its core, IDLE prioritizes user agency, transparency, and reversibility. Detections reflect measured digital patterns rather than clinical predictions; IDLE does not diagnose, treat, or guarantee prevention of migraines, vertigo, photosensitivity, or sensory overload." />
                    </StackPanel>
                </Border>

                <!-- How It Works & Core Principles Card -->
                <Border Padding="20" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="14">
                        <TextBlock Text="How IDLE Operates" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <Grid ColumnSpacing="16" RowSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="1. Acquire" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Access only the supported signals needed for an enabled detector." Opacity="0.85" TextWrapping="Wrap" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="2. Analyse" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="Extract measurable features such as luminance changes, contrast, or motion." Opacity="0.85" TextWrapping="Wrap" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="3. Detect" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="Identify patterns defined by deterministic rules or evaluated models." Opacity="0.85" TextWrapping="Wrap" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="4. Decide" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="Apply user settings, confidence scores, exclusions, and safety rules." Opacity="0.85" TextWrapping="Wrap" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="5. Intervene" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="Offer or apply proportionate, completely reversible protective adaptations." Opacity="0.85" TextWrapping="Wrap" />

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="6. Evaluate" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="Measure accuracy, false positives, latency, and resource overhead locally." Opacity="0.85" TextWrapping="Wrap" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Collapsible Documentation Section -->
                <StackPanel Spacing="10">
                    <TextBlock Text="Documentation &amp; Policies" Style="{StaticResource SubtitleTextBlockStyle}" />

                    <!-- Architecture Expander -->
                    <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE950;" FontSize="16" />
                                <TextBlock Text="System Architecture" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Expander.Header>
                        <StackPanel Spacing="10" Padding="14">
                            <TextBlock TextWrapping="Wrap" LineHeight="20" Opacity="0.9"
                                       Text="The IDLE architecture decouples detection from intervention decisions. Signals flow through Input Adapters to Feature Extraction (luminance statistics and motion vectors), then to Detection Modules, into the Policy Engine with user exclusions, and finally through Intervention Adapters." />
                            <TextBlock TextWrapping="Wrap" LineHeight="20" Opacity="0.9"
                                       Text="Design goals include minimal data retention, independent detector testability, safe handling of missing permissions, and local ephemeral execution." />
                            <HyperlinkButton Content="View architecture.md on GitHub" NavigateUri="https://github.com/aryandas079/IDLE/blob/main/docs/architecture.md" />
                        </StackPanel>
                    </Expander>

                    <!-- Privacy and Safety Expander -->
                    <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE72E;" FontSize="16" />
                                <TextBlock Text="Privacy &amp; Safety Principles" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Expander.Header>
                        <StackPanel Spacing="10" Padding="14">
                            <TextBlock TextWrapping="Wrap" LineHeight="20" Opacity="0.9"
                                       Text="• Local-First: Frame analysis runs locally in ephemeral memory by default. No raw screen recordings are retained." />
                            <TextBlock TextWrapping="Wrap" LineHeight="20" Opacity="0.9"
                                       Text="• User Control: All automatic interventions are pauseable, adjustable, and reversible at any moment." />
                            <TextBlock TextWrapping="Wrap" LineHeight="20" Opacity="0.9"
                                       Text="• Medical Boundary: IDLE is an assistive comfort utility, not a clinical device. Detections do not establish medical diagnosis or guaranteed episode prevention." />
                            <HyperlinkButton Content="View privacy-and-safety.md on GitHub" NavigateUri="https://github.com/aryandas079/IDLE/blob/main/docs/privacy-and-safety.md" />
                        </StackPanel>
                    </Expander>

                    <!-- Development Roadmap Expander -->
                    <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE81C;" FontSize="16" />
                                <TextBlock Text="Development Roadmap" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Expander.Header>
                        <StackPanel Spacing="10" Padding="14">
                            <TextBlock TextWrapping="Wrap" LineHeight="20" Opacity="0.9"
                                       Text="• Phase 1: Research, specifications, synthetic test cases, and MVP definitions." />
                            <TextBlock TextWrapping="Wrap" LineHeight="20" Opacity="0.9"
                                       Text="• Phase 2: Visual detection baseline (luminance deltas, temporal brightness transitions, and motion features)." />
                            <TextBlock TextWrapping="Wrap" LineHeight="20" Opacity="0.9"
                                       Text="• Phase 3: Supported protective interventions and browser integration with reversible overrides." />
                            <TextBlock TextWrapping="Wrap" LineHeight="20" Opacity="0.9"
                                       Text="• Phase 4: Preferences, user profiles, telemetry controls, and empirical evaluation." />
                            <HyperlinkButton Content="View roadmap.md on GitHub" NavigateUri="https://github.com/aryandas079/IDLE/blob/main/docs/roadmap.md" />
                        </StackPanel>
                    </Expander>

                    <!-- Testing & Evaluation Plan Expander -->
                    <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE9D9;" FontSize="16" />
                                <TextBlock Text="Testing &amp; Evaluation Plan" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Expander.Header>
                        <StackPanel Spacing="10" Padding="14">
                            <TextBlock TextWrapping="Wrap" LineHeight="20" Opacity="0.9"
                                       Text="Evaluates engineering metrics including Precision (TP / (TP + FP)), Recall (TP / (TP + FN)), False Alerts per hour, and end-to-end Intervention Latency using deterministic synthetic stimulus fixtures." />
                            <HyperlinkButton Content="View evaluation-plan.md on GitHub" NavigateUri="https://github.com/aryandas079/IDLE/blob/main/docs/evaluation-plan.md" />
                        </StackPanel>
                    </Expander>

                    <!-- Research & References Expander -->
                    <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE82D;" FontSize="16" />
                                <TextBlock Text="Research &amp; References" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Expander.Header>
                        <StackPanel Spacing="10" Padding="14">
                            <TextBlock TextWrapping="Wrap" LineHeight="20" Opacity="0.9"
                                       Text="Grounds design choices on W3C Web Content Accessibility Guidelines (WCAG), CSS prefers-reduced-motion, photosensitive seizure safety guidance, and verified computer vision benchmarks." />
                            <HyperlinkButton Content="View research-and-references.md on GitHub" NavigateUri="https://github.com/aryandas079/IDLE/blob/main/docs/research-and-references.md" />
                        </StackPanel>
                    </Expander>

                    <!-- Security Policy Expander -->
                    <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xEA18;" FontSize="16" />
                                <TextBlock Text="Security Policy (SECURITY.md)" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Expander.Header>
                        <StackPanel Spacing="10" Padding="14">
                            <TextBlock TextWrapping="Wrap" LineHeight="20" Opacity="0.9"
                                       Text="Responsible vulnerability reporting guidelines, secret management standards, and security design priorities ensuring minimal browser permissions and safe fallback behaviors." />
                            <HyperlinkButton Content="View SECURITY.md on GitHub" NavigateUri="https://github.com/aryandas079/IDLE/blob/main/SECURITY.md" />
                        </StackPanel>
                    </Expander>

                    <!-- License Expander -->
                    <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE8A5;" FontSize="16" />
                                <TextBlock Text="License (Apache-2.0)" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Expander.Header>
                        <StackPanel Spacing="10" Padding="14">
                            <TextBlock TextWrapping="Wrap" LineHeight="20" Opacity="0.9"
                                       Text="Licensed under the Apache License, Version 2.0. Copyright (c) IDLE Project Contributors. Grants permissions for commercial use, modification, distribution, and patent use with attribution." />
                            <HyperlinkButton Content="View LICENSE file" NavigateUri="https://github.com/aryandas079/IDLE/blob/main/LICENSE" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

